# Required production settings. Keep the real values in your secret manager,
# systemd EnvironmentFile, or hosting-platform environment variables.
ATTENDQR_ENV=production
SECRET_KEY=replace-with-a-random-48-plus-character-secret
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password
DATABASE_URL=postgresql://attendqr:replace-me@db.example.internal:5432/attendqr

# Gunicorn / reverse proxy
PORT=5001
WEB_CONCURRENCY=4
GUNICORN_THREADS=2
TRUSTED_PROXY_HOPS=1
SESSION_MAX_AGE_HOURS=8
MAX_UPLOAD_MB=10
